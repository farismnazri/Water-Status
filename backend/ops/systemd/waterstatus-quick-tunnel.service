[Unit]
Description=Cloudflare quick tunnel for Water-Status API
After=network-online.target waterstatus-api.service
Wants=network-online.target
Requires=waterstatus-api.service
StartLimitIntervalSec=1800
StartLimitBurst=3

[Service]
Type=simple
User=faiz
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env cloudflared tunnel --url http://127.0.0.1:8000 --no-autoupdate
Restart=on-failure
RestartSec=300

[Install]
WantedBy=multi-user.target
